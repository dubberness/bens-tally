{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts", "../src/lib/betashares/*.ts"],
	"exclude": [
		"../src/lib/betashares/*.spec.ts",
		"../src/lib/betashares/test-mail.ts",
