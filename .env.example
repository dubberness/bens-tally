# Copy to .env for local development. Real values live in the Unraid container settings.
DATA_DIR=./data
ORIGIN=http://localhost:5173
OIDC_ISSUER=https://pocketid.benpost.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: comma-separated Pocket-ID subjects allowed in. Empty = the first person to sign in becomes the owner.
OIDC_ALLOWED_SUBJECTS=
# Development only: skip Pocket-ID when running `npm run dev`. Ignored in a production build.
DEV_SKIP_LOGIN=
UP_TOKEN=
# Optional: the mail Worker Betashares emails are collected from (worker/README.md).
WORKER_URL=
WORKER_TOKEN=
